# ==============================================================================
# ContentFlow 统一环境与 API 配置文件
# 复制此文件为 .env 并在需要使用的服务中填入对应的 API Key
# 命令: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 火山方舟 (VolcEngine Ark) - 推荐全套二次元手办生产底座 (支持 Scheme B 双 Key 协同)
# 适用：
#   - 生图：Doubao-Seedream 5.0 (手办全身立绘、多动作一致性生成)
#   - 生视频：Doubao-Seedance 1.5 Pro / 2.0 / 2.5 (图生视频、动作驱动迁移)
# 双 Key 路由策略：
#   - ARK_API_KEY: Coding Plan / AgentPlan 专属 Key (以 ark- 开头)，用于 Seedream 5.0 生图；
#     若未配置 ARK_PAYG_API_KEY，视频生成会先尝试 AgentPlan 接口并自动回退至标准 /api/v3 接口。
#   - ARK_PAYG_API_KEY: 火山方舟标准按量付费 (Pay-As-You-Go) API Key (UUID 格式，无 ark- 前缀)。
#     配置后视频生成将优先直连 https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks，
#     自动轮询 doubao-seedance-1-5-pro-250528 / doubao-seedance-1-0-pro-250528 / doubao-seedance-2.0。
# 控制台: https://console.volcengine.com/ark
# ------------------------------------------------------------------------------
ARK_API_KEY=
ARK_PAYG_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ------------------------------------------------------------------------------
# 2. 火山引擎语音合成 (OpenSpeech V3 / Seed-TTS 2.0)
# 适用：二次元角色台词配音（2B 知性清冷音、能代少女灵动音、双快思思等）
# 控制台: https://console.volcengine.com/speech/service/8
# 若未单独配置，系统将默认复用 ARK_API_KEY
# ------------------------------------------------------------------------------
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional

# ------------------------------------------------------------------------------
# 3. 快手可灵 AI (Kling AI) - 动作驱动 (Motion Control) 与图生视频主力/备选
# 适用：路径3（单图手办图生视频 /v1/videos/image2video，或输入参考舞蹈视频 + 手办锚点图进行动作迁移）
# 鉴权方式（二选一）：
#   - 方式 A (推荐): 填入 KLING_ACCESS_KEY 与 KLING_SECRET_KEY，路由器内置纯 Python HS256 JWT
#     签名器（零外部 pyjwt 依赖），自动按需签发 Bearer Token。
#   - 方式 B: 直接填入预签发或网关代理的 KLING_API_KEY (Bearer Token)。
# 开放平台: https://klingai.com/
# ------------------------------------------------------------------------------
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com

# ------------------------------------------------------------------------------
# 4. MiniMax (海螺 AI) - 视频生成备选
# 适用：高动态光影与运镜生成
# 开放平台: https://api.minimax.chat/
# ------------------------------------------------------------------------------
MINIMAX_API_KEY=

# ------------------------------------------------------------------------------
# 5. 通用大语言模型 (Agent 思考中枢：剧本分镜、动作节奏卡点与提示词工程)
# 默认支持 DeepSeek / 豆包语言模型 / OpenAI 兼容协议
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 6. 本地增强引擎配置 (RIFE 极速插帧与 Real-ESRGAN 超分抗锯齿)
# 默认直接使用 vendor/bin/ 中的本地独立 GPU 引擎，零 API 消耗
# ------------------------------------------------------------------------------
ENHANCER_RIFE_MODEL=rife-v4.6
ENHANCER_UPSCALE_SCALE=2
ENHANCER_TARGET_FPS=60

# ------------------------------------------------------------------------------
# 7. 火山方舟素材与中间产物存储目录（项目内部忽略目录，严禁污染用户主目录）
# ------------------------------------------------------------------------------
ARK_SEEDREAM_SAVE_PATH=./output/seedream_raw
ARK_SEEDANCE_SAVE_PATH=./output/seedance_raw
