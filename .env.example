# ==============================================================================
# ContentFlow 统一环境与 API 配置文件
# 复制此文件为 .env 并在需要使用的服务中填入对应的 API Key
# 命令: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 火山方舟 (VolcEngine Ark) - 推荐全套二次元手办生产底座
# 适用：
#   - 生图：Doubao-Seedream 5.0 (手办全身立绘、多动作一致性生成)
#   - 生视频：Doubao-Seedance 2.5 (图生视频、动作驱动迁移)
# 控制台: https://console.volcengine.com/ark
# ------------------------------------------------------------------------------
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ------------------------------------------------------------------------------
# 2. 火山引擎语音合成 (OpenSpeech V3 / Seed-TTS 2.0)
# 适用：二次元角色台词配音（2B 知性清冷音、能代少女灵动音、双快思思等）
# 控制台: https://console.volcengine.com/speech/service/8
# 若未单独配置，系统将默认复用 ARK_API_KEY
# ------------------------------------------------------------------------------
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional

# ------------------------------------------------------------------------------
# 3. 快手可灵 AI (Kling AI) - 动作驱动与图生视频备选
# 适用：路径3（输入单人舞蹈视频与手办图，进行高保真动作迁移）
# 开放平台: https://klingai.com/
# ------------------------------------------------------------------------------
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ------------------------------------------------------------------------------
# 4. MiniMax (海螺 AI) - 视频生成备选
# 适用：高动态光影与运镜生成
# 开放平台: https://api.minimax.chat/
# ------------------------------------------------------------------------------
MINIMAX_API_KEY=

# ------------------------------------------------------------------------------
# 5. 通用大语言模型 (Agent 思考中枢：剧本分镜、动作节奏卡点与提示词工程)
# 默认支持 DeepSeek / 豆包语言模型 / OpenAI 兼容协议
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 6. 本地增强引擎配置 (RIFE 极速插帧与 Real-ESRGAN 超分抗锯齿)
# 默认直接使用 vendor/bin/ 中的本地独立 GPU 引擎，零 API 消耗
# ------------------------------------------------------------------------------
ENHANCER_RIFE_MODEL=rife-v4.6
ENHANCER_UPSCALE_SCALE=2
ENHANCER_TARGET_FPS=60

# ------------------------------------------------------------------------------
# 7. 火山方舟素材与中间产物存储目录（项目内部忽略目录，严禁污染用户主目录）
# ------------------------------------------------------------------------------
ARK_SEEDREAM_SAVE_PATH=./output/seedream_raw
ARK_SEEDANCE_SAVE_PATH=./output/seedance_raw

