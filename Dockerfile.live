# ContentFlow 100% Headless Zero-Mic Dual-AI Livestream Sandbox Container
# Guarantees:
# - Non-root execution (`liveuser`, UID 10001)
# - Zero microphone or host audio hardware devices required or mounted
# - 100% synthetic 48kHz stereo PCM audio + Pillow/NumPy 1920x1080 30FPS video

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/home/liveuser

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ffmpeg \
        fontconfig \
        fonts-noto-cjk \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "aiohttp>=3.9.0" \
    "edge-tts>=7.0.0" \
    "httpx>=0.27.0" \
    "numpy>=1.26.0" \
    "pillow>=10.4.0" \
    "pydantic>=2.7.0" \
    "requests>=2.32.0"

RUN groupadd --gid 10001 liveuser \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin liveuser

WORKDIR /app

COPY pyproject.toml /app/pyproject.toml
COPY config /app/config
COPY core /app/core
COPY scripts /app/scripts
COPY library/characters /app/library/characters
COPY projects/017_dafeiyu_gemini_channel_war_ep1/assets/cover_clean_studio_bg_16x9.jpg \
     /app/projects/017_dafeiyu_gemini_channel_war_ep1/assets/cover_clean_studio_bg_16x9.jpg

RUN mkdir -p /app/output /home/liveuser/.contentflow/accounts \
    && chown -R liveuser:liveuser /app /home/liveuser

USER liveuser

ENTRYPOINT ["python", "scripts/launch_headless_live.py"]
CMD ["--mode", "dry-stream", "--duration-sec", "60", "--output-mp4", "/tmp/live_dry_stream.mp4"]
